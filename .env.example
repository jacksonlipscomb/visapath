# Supabase Auth configuration.
# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Vite inlines VITE_* vars at build time, so these
# must also be set in the Cloudflare build environment for production.
#
# SAFE to expose in the browser bundle: the project URL and the PUBLISHABLE key
# (or the legacy "anon" key). NEVER put a secret / service_role key here
# (e.g. sb_secret_* or the service_role JWT) — it must stay server-side only.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
